# External benchmark checkouts (reproducible via scripts/fetch_external.sh)
external/

# Downloaded datasets (reproducible via `docbench datasets fetch`)
datasets/data/

# Runtime artifacts
var/
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/
.secrets/
var-download*.log

# Superseded local English exploratory runs. They lack the Russian dataset and
# reproducibility contract used by the published supplementary leaderboard.
x/

# Local Graphify index/cache; useful on this machine but generated and not a
# benchmark artifact to publish.
graphify-out/

# Provider keys — local only, must never reach the repo.
# .env in CWD is read first by docbench; ~/.config/docbench/env is the machine-wide
# fallback; the real process environment overrides both. Use .env.example as a
# template and copy to .env on each machine, then chmod 600.
.env
.env.*.local

# IRI real-case material is local-only: raw packet, private gold and provider
# receipts must never enter a public checkout.
cases/iri-review/*.private.yaml
