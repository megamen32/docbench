# External benchmark checkouts (reproducible via scripts/fetch_external.sh)
external/

# Downloaded datasets (reproducible via `docbench datasets fetch`)
datasets/data/

# Runtime artifacts
var/
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/
.secrets/
var-download*.log

# Provider keys — local only, must never reach the repo.
# .env in CWD is read first by docbench; ~/.config/docbench/env is the machine-wide
# fallback; the real process environment overrides both. Use .env.example as a
# template and copy to .env on each machine, then chmod 600.
.env
.env.*.local
