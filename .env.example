# docbench provider keys — TEMPLATE, copy to .env on each machine (chmod 600).
# All values are real keys' variables; replace with your own:
#   .env            -> per-project, gitignored, resolves first
#   ~/.config/docbench/env -> machine-wide, chmod 600, resolves second
#   export VAR=...  -> real process env, resolves third (overrides everything)
#
# Generated .env.example is committed for onboarding; never commit .env itself.

DOCBENCH_MINIMAX_API_KEY=
DOCBENCH_MINIMAX_BASE_URL=https://api.minimax.io/v1

DOCBENCH_ZAI_API_KEY=
DOCBENCH_ZAI_BASE_URL=https://api.z.ai/api/paas/v4

DOCBENCH_OMNIROUTE_API_KEY=
DOCBENCH_OMNIROUTE_BASE_URL=https://omniroute.bezrabotnyi.com/v1